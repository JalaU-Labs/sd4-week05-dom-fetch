{
  "name": "sd4-week05-dom-fetch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "description": "Week 05 laboratory - DOM manipulation and Fetch API consumption with DummyJSON",
  "author": "Diego Alejandro Botina",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "predev": "pnpm run css:build",
    "dev": "concurrently -k -n tailwind,vite -c blue,green \"pnpm run css:watch\" \"vite\"",
    "prebuild": "pnpm run css:build",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "css:build": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --minify",
    "css:watch": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
